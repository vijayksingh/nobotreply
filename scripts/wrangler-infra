#!/usr/bin/env bash
set -euo pipefail

# Keep Cloudflare credentials in the host's secret store. This wrapper exposes
# them only to the Wrangler process and never copies them into the repository.
#
#   scripts/wrangler-infra whoami
#   scripts/wrangler-infra pages deploy dist --project-name nobotreply --branch main
#
# Requires passwordless sudo to read the secret file, then drops back to the
# invoking user to run Wrangler. Override with:
#
#   CLOUDFLARE_SECRETS=/path/to/cloudflare.env   (default below)
#   CLOUDFLARE_API_TOKEN=...                     bypass the store entirely
#   CLOUDFLARE_ACCOUNT_ID=...                    otherwise taken from the store
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WRANGLER_BIN="$PROJECT_DIR/node_modules/.bin/wrangler"

CLOUDFLARE_SECRETS="${CLOUDFLARE_SECRETS:-/opt/infra/secrets/cloudflare.env}"
CLOUDFLARE_ACCOUNT_ID="${CLOUDFLARE_ACCOUNT_ID:-}"
CLOUDFLARE_API_TOKEN="${CLOUDFLARE_API_TOKEN:-}"

# Run Wrangler as the user who invoked this script, not as root and not as a
# hardcoded account, so the wrapper is portable across hosts.
RUN_AS="$(id -un)"

# Resolve dependencies before loading credentials. Never let a package manager
# or network-backed executable inherit the Cloudflare token.
if [[ ! -x "$WRANGLER_BIN" ]]; then
  echo "Pinned Wrangler is missing. Run npm install in $PROJECT_DIR before deploying." >&2
  exit 1
fi

# These must be exported, otherwise `sudo --preserve-env` has nothing to carry.
export CLOUDFLARE_SECRETS CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_API_TOKEN

exec sudo \
  --preserve-env=CLOUDFLARE_SECRETS,CLOUDFLARE_ACCOUNT_ID,CLOUDFLARE_API_TOKEN \
  zsh -c '
    wrangler_bin="$1"; run_as="$2"; shift 2
    secrets="${CLOUDFLARE_SECRETS:-/opt/infra/secrets/cloudflare.env}"

    # An explicit token wins, so CI or a one-off run can bypass the store.
    if [[ -z "${CLOUDFLARE_API_TOKEN:-}" ]]; then
      if [[ ! -r "$secrets" ]]; then
        echo "wrangler-infra: cannot read $secrets — run with sudo, or set CLOUDFLARE_API_TOKEN" >&2
        exit 1
      fi
      set -a
      source "$secrets"
      set +a
      # The store names it CF_DNS_API_TOKEN; Wrangler wants CLOUDFLARE_API_TOKEN.
      if [[ -n "${CF_DNS_API_TOKEN:-}" ]]; then
        export CLOUDFLARE_API_TOKEN="$CF_DNS_API_TOKEN"
      fi
      if [[ -z "${CLOUDFLARE_API_TOKEN:-}" ]]; then
        echo "wrangler-infra: $secrets defines neither CF_DNS_API_TOKEN nor CLOUDFLARE_API_TOKEN" >&2
        exit 1
      fi
    fi

    # Account id is optional; Wrangler infers it when the token sees one account.
    if [[ -z "${CLOUDFLARE_ACCOUNT_ID:-}" ]]; then
      unset CLOUDFLARE_ACCOUNT_ID
    else
      export CLOUDFLARE_ACCOUNT_ID
    fi

    export NODE_OPTIONS="--dns-result-order=ipv4first"
    exec sudo -u "$run_as" \
      --preserve-env=CLOUDFLARE_API_TOKEN,CLOUDFLARE_ACCOUNT_ID,NODE_OPTIONS \
      "$wrangler_bin" "$@"
  ' wrangler-infra "$WRANGLER_BIN" "$RUN_AS" "$@"
