#!/usr/bin/env bash
set -euo pipefail

# Keep Cloudflare credentials in the infra secret store. This wrapper exposes
# them only to the Wrangler process and never copies them into the repository.
#
#   scripts/wrangler-infra whoami
#   scripts/wrangler-infra pages deploy dist --project-name nobotreply --branch main
#
# Mirrors the convention used by the other projects on platform-01.
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WRANGLER_BIN="$PROJECT_DIR/node_modules/.bin/wrangler"

# Resolve dependencies before loading credentials. Never let a package manager
# or network-backed executable inherit the Cloudflare token.
if [[ ! -x "$WRANGLER_BIN" ]]; then
  echo "Pinned Wrangler is missing. Run npm install in $PROJECT_DIR before deploying." >&2
  exit 1
fi

exec sudo zsh -c '
  wrangler_bin="$1"
  shift
  set -a
  source /opt/infra/secrets/cloudflare.env
  set +a
  export CLOUDFLARE_API_TOKEN="$CF_DNS_API_TOKEN"
  export CLOUDFLARE_ACCOUNT_ID="e3ae6e5dd1aac7f5d4c1d4aa45c00f83"
  export NODE_OPTIONS="--dns-result-order=ipv4first"
  exec sudo -u admin \
    --preserve-env=CLOUDFLARE_API_TOKEN,CLOUDFLARE_ACCOUNT_ID,NODE_OPTIONS \
    "$wrangler_bin" "$@"
' wrangler-infra "$WRANGLER_BIN" "$@"
